{
  "version": 1,
  "hooks": {
    "afterFileEdit": [
      {
        "command": "pnpm lint",
        "pattern": "src/**/*.ts"
      },
      {
        "command": "pnpm format",
        "pattern": "src/**/*.ts"
      },
      {
        "command": "pnpm exec prisma format",
        "pattern": "prisma/**/*.prisma"
      }
    ]
  }
}
