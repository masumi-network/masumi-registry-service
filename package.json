{
  "name": "masumi-registry-service",
  "version": "0.0.5",
  "description": "A Registry Lookup service for MASUMI AI Nodes",
  "main": "dist/index.js",
  "author": "NMKR",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "prisma": {
    "seed": "tsx ./prisma/seed.ts"
  },
  "scripts": {
    "prepare": "husky",
    "preinstall": "node -e \"if (!(process.env.npm_config_user_agent||'').startsWith('pnpm')) { console.error('\\nThis project uses pnpm. Use: pnpm install\\n'); process.exit(1); }\"",
    "lint": "eslint --fix --quiet --config eslint.config.mjs",
    "format": "prettier --log-level silent --write src/**/*.ts",
    "test": "export DATABASE_URL=http://set-mock-env-for-generation.com && jest",
    "test:watch": "export DATABASE_URL=http://set-mock-env-for-generation.com && jest --watch",
    "test:coverage": "export DATABASE_URL=http://set-mock-env-for-generation.com && jest --coverage",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "dev": "tsx watch ./src/index.ts",
    "build": "prisma generate && tsc --noEmit && pkgroll && mkdir -p dist/public && cp -r public/* dist/public/",
    "start": "NODE_ENV=production && node ./dist/index.js",
    "swagger-json": "export DATABASE_URL=http://set-mock-env-for-generation.com && tsx ./src/utils/swagger-generator/cli.ts",
    "knip": "knip"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "7.3.4",
    "@blockfrost/blockfrost-js": "6.1.1",
    "@jest/types": "29.6.3",
    "@meshsdk/core": "1.8.14",
    "@paralleldrive/cuid2": "2.3.1",
    "@prisma/client": "6.19.3",
    "async-mutex": "0.5.0",
    "dotenv": "16.6.1",
    "express": "5.2.1",
    "express-zod-api": "22.14.1",
    "http-errors": "2.0.1",
    "logform": "2.7.0",
    "swagger-ui-express": "5.0.1",
    "winston": "3.19.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/http-errors": "2.0.5",
    "@types/jest": "29.5.14",
    "@types/node": "20.19.41",
    "@types/swagger-ui-express": "4.1.8",
    "eslint": "10.3.0",
    "globals": "16.5.0",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "knip": "5.88.1",
    "lint-staged": "15.5.2",
    "pkgroll": "2.27.0",
    "prettier": "3.8.3",
    "prisma": "6.19.3",
    "ts-jest": "29.4.9",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.3"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "pnpm run lint",
      "pnpm run format"
    ]
  }
}
