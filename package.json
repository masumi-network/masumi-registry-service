{
  "name": "masumi-registry-service",
  "version": "0.0.5",
  "description": "A Registry Lookup service for MASUMI AI Nodes",
  "main": "dist/index.js",
  "author": "NMKR",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "prisma": {
    "seed": "tsx ./prisma/seed.ts"
  },
  "scripts": {
    "prepare": "husky",
    "preinstall": "node -e \"if (!(process.env.npm_config_user_agent||'').startsWith('pnpm')) { console.error('\\nThis project uses pnpm. Use: pnpm install\\n'); process.exit(1); }\"",
    "lint": "eslint --fix --quiet --config eslint.config.mjs src/",
    "format": "prettier --log-level silent --write src/**/*.ts",
    "test": "export DATABASE_URL=postgresql://mock-user:mock-pass@localhost:5432/mock-testdb && jest",
    "test:watch": "export DATABASE_URL=postgresql://mock-user:mock-pass@localhost:5432/mock-testdb && jest --watch",
    "test:coverage": "export DATABASE_URL=postgresql://mock-user:mock-pass@localhost:5432/mock-testdb && jest --coverage",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "dev": "tsx watch ./src/index.ts",
    "build": "prisma generate && tsc --noEmit && pkgroll && mkdir -p dist/public && cp -r public/* dist/public/",
    "start": "NODE_ENV=production && node ./dist/index.js",
    "swagger-json": "export DATABASE_URL=postgresql://mock-user:mock-pass@localhost:5432/mock-testdb && tsx ./src/utils/swagger-generator/cli.ts",
    "knip": "knip",
    "snapshot:export": "tsx ./src/scripts/snapshot-export.ts",
    "snapshot:import": "tsx ./src/scripts/snapshot-import.ts",
    "snapshot:import:dry": "tsx ./src/scripts/snapshot-import.ts --dry-run"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "8.5.0",
    "@blockfrost/blockfrost-js": "6.1.1",
    "@meshsdk/core": "1.9.0-beta.102",
    "@meshsdk/core-cst": "1.9.0-beta.102",
    "@paralleldrive/cuid2": "3.3.0",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "async-mutex": "0.5.0",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-zod-api": "28.0.0",
    "http-errors": "2.0.1",
    "logform": "2.7.0",
    "pg": "8.20.0",
    "swagger-ui-express": "5.0.1",
    "winston": "3.19.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@babel/plugin-transform-modules-commonjs": "7.28.6",
    "@commitlint/cli": "21.0.1",
    "@commitlint/config-conventional": "21.0.1",
    "@eslint/js": "10.0.1",
    "@jest/types": "30.4.1",
    "@types/express": "5.0.6",
    "@types/http-errors": "2.0.5",
    "@types/jest": "30.0.0",
    "@types/node": "22.19.19",
    "@types/pg": "8.20.0",
    "@types/swagger-ui-express": "4.1.8",
    "babel-jest": "30.4.1",
    "eslint": "10.3.0",
    "globals": "17.6.0",
    "husky": "9.1.7",
    "jest": "30.4.2",
    "knip": "6.13.1",
    "lint-staged": "17.0.4",
    "pkgroll": "2.27.0",
    "prettier": "3.8.3",
    "prisma": "7.8.0",
    "ts-jest": "29.4.9",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.3"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "pnpm run lint",
      "pnpm run format"
    ]
  }
}
