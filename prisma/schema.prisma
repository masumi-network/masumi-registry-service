// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model ApiKey {
  id                      String       @id @default(cuid())
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  tokenHash               String       @unique
  status                  APIKeyStatus
  permission              Permission
  usageLimited            Boolean      @default(false)
  accumulatedUsageCredits Float        @default(0)
  maxUsageCredits         Float?
  Usage                   UsageEntry[]
}

enum APIKeyStatus {
  Active
  Revoked
}

enum Permission {
  User
  Admin
}

model UsageEntry {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  usedCredits Float
  note        String?

  ApiKey   ApiKey? @relation(fields: [apiKeyId], references: [id])
  apiKeyId String?
}

model RegistryEntry {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name               String
  // Agent access model. Standard for legacy/untyped entries; OpenApi/X402 carry
  // an alternative endpoint descriptor (openApiSpecUrl / x402ResourcesUrl).
  type               RegistryEntryType @default(Standard)
  // Required for Standard entries; null for OpenApi/X402 which describe their
  // endpoints via openApiSpecUrl / x402ResourcesUrl.
  apiBaseUrl         String?
  // URL of the agent's OpenAPI 3.1.x spec document. Set only for OpenApi entries.
  openApiSpecUrl     String?
  // URL of the agent's self-hosted x402 resource manifest. Set only for X402
  // entries; the loose priced resources live in the pointed-to JSON, not here.
  x402ResourcesUrl   String?
  // Last successfully fetched + validated spec snapshot (OpenApi doc / x402
  // manifest), cached so GET /registry-entry/{id}/spec serves a known-good copy
  // decoupled from a transiently-down agent. Null for Standard entries and until
  // the first successful validation. specValidatedAt is when it was last proven
  // valid; the periodic health loop refreshes both and reconciles status.
  spec               Json?
  specValidatedAt    DateTime?
  description        String?
  authorName         String?
  authorContactEmail String?
  authorContactOther String?
  authorOrganization String?

  privacyPolicy     String?
  termsAndCondition String?
  otherLegal        String?
  image             String
  tags              String[]

  lastUptimeCheck  DateTime
  uptimeCount      Int            @default(0)
  uptimeCheckCount Int            @default(0)
  // Rolling uptime (0-1): each interval between health checks is weighted by
  // its length with exponential decay (7-day half-life), so the check rate
  // does not move it. Null until the first check. Feeds ranking.
  uptimeEwma       Float?
  status           Status
  statusUpdatedAt  DateTime       @default(now())
  RegistrySource   RegistrySource @relation(fields: [registrySourceId], references: [id], onDelete: Cascade)

  paymentType    PaymentType @default(Web3CardanoV1)
  Capability     Capability? @relation(fields: [capabilitiesId], references: [id])
  capabilitiesId String?

  registrySourceId String

  assetIdentifier String        @unique
  searchText      String        @default("")
  AgentPricing    AgentPricing?

  ExampleOutput ExampleOutput[]

  SupportedPaymentSources SupportedPaymentSource[]
  Verifications           AgentVerification[]
  HealthCheckEvents       HealthCheckEvent[]
  X402ResourceProbes      X402ResourceProbe[]
  X402OpenApiDiscoveries  X402OpenApiDiscovery[]
  A2A                     A2ARegistryEntry?

  metadataVersion Int

  @@index([statusUpdatedAt])
  @@index([statusUpdatedAt, id])
  @@index([createdAt])
}

// Payment sources advertised in a V2 registry entry's metadata
// (supported_payment_sources). One row per advertised source: Cardano escrow
// rows carry paymentSourceType + address; x402/EVM rows carry settlement and
// token constraint fields. Complete pricing is source-owned through Pricing.
// Indexed read model — re-synced from chain, never minted.
model SupportedPaymentSource {
  id                String   @id @default(cuid())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  chain             String
  network           String
  sourceIndex       Int
  paymentSourceType String?
  address           String
  scheme            String?
  dynamicAsset      String?
  dynamicDecimals   Int?
  fixedDecimals     Int?
  payTo             String?
  resource          String?
  extra             Json?

  RegistryEntry   RegistryEntry @relation(fields: [registryEntryId], references: [id], onDelete: Cascade)
  registryEntryId String
  Pricing         AgentPricing?

  @@unique([registryEntryId, sourceIndex])
  @@index([registryEntryId])
}

// A2A (MIP-002) descriptor for an A2A-typed registry entry. Held in its own 1:1
// table rather than as columns on RegistryEntry so that each access model's
// type-specific fields stay out of the shared row — otherwise every new type
// adds more columns that are NULL for every other type. The Agent Card document
// itself is not exploded here: it is fetched, validated and cached whole in
// RegistryEntry.spec (see services/spec-validation), same as an OpenApi doc or
// x402 manifest. Read model — re-synced from chain, never minted.
model A2ARegistryEntry {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Agent Card location, e.g. https://{domain}/.well-known/agent-card.json.
  agentCardUrl String
  // Protocol versions claimed on-chain. Each must appear in the fetched card's
  // protocolVersions, else the entry is marked Invalid.
  protocolVersions String[]

  RegistryEntry   RegistryEntry @relation(fields: [registryEntryId], references: [id], onDelete: Cascade)
  registryEntryId String        @unique
}

// KERI/Veridian verification claim advertised in a V2 registry entry's metadata.
// Flat columns reconstruct the nested issuer/schema/credential/holder shape at
// the API boundary. Read model — re-synced from chain.
model AgentVerification {
  id                 String   @id @default(cuid())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  method             String
  schemaVersion      String?
  issuerAid          String
  issuerOobi         String
  schemaSaid         String
  schemaOobi         String
  credentialSaid     String
  credentialOobi     String
  credentialRegistry String?
  holderAid          String
  holderOobi         String
  baseUrl            String?

  RegistryEntry   RegistryEntry @relation(fields: [registryEntryId], references: [id], onDelete: Cascade)
  registryEntryId String

  @@index([registryEntryId])
}

model InboxAgentRegistration {
  id              String                       @id @default(cuid())
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt
  status          InboxAgentRegistrationStatus @default(Pending)
  statusUpdatedAt DateTime                     @default(now())

  name                 String
  description          String?
  agentSlug            String
  providerUrl          String?
  assetIdentifier      String  @unique
  linkedEmail          String?
  encryptionPublicKey  String?
  encryptionKeyVersion String?
  signingPublicKey     String?
  signingKeyVersion    String?
  metadataVersion      Int

  RegistrySource   RegistrySource @relation(fields: [registrySourceId], references: [id], onDelete: Cascade)
  registrySourceId String

  @@index([name])
  @@index([agentSlug])
  @@index([linkedEmail])
  @@index([status])
  @@index([registrySourceId])
  @@index([registrySourceId, status, updatedAt])
  @@index([statusUpdatedAt])
  @@index([statusUpdatedAt, id])
}

model ExampleOutput {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  name      String
  mimeType  String
  url       String

  RegistryEntry   RegistryEntry? @relation(fields: [registryEntryId], references: [id])
  registryEntryId String?
}

model AgentPricing {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pricingType              PricingType
  FixedPricing             AgentFixedPricing?
  RegistryEntry            RegistryEntry?          @relation(fields: [registryEntryId], references: [id], onDelete: Cascade)
  registryEntryId          String?                 @unique
  SupportedPaymentSource   SupportedPaymentSource? @relation(fields: [supportedPaymentSourceId], references: [id], onDelete: Cascade)
  supportedPaymentSourceId String?                 @unique
}

enum PricingType {
  Fixed
  Free
  Dynamic
}

model AgentFixedPricing {
  id             String       @id @default(cuid())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  AgentPricing   AgentPricing @relation(fields: [agentPricingId], references: [id], onDelete: Cascade)
  agentPricingId String       @unique
  Amounts        UnitValue[]
}

model UnitValue {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  amount              BigInt
  unit                String
  AgentFixedPricing   AgentFixedPricing @relation(fields: [agentFixedPricingId], references: [id], onDelete: Cascade)
  agentFixedPricingId String

  @@index([agentFixedPricingId, unit])
}

enum PaymentType {
  Web3CardanoV1
  Web3CardanoV2
  None
}

// Agent access model advertised in the registry metadata `type` field. Absent
// on-chain `type` (and legacy rows) map to Standard. On-chain string values:
// Standard = absent, OpenApi = "OpenAPI", X402 = "x402V1", A2A = "a2aV1". Kept in
// sync with the payment-service RegistryEntryType. See docs (payment-service ADR
// 0010) and MIP-002-A2A for the A2A variant.
enum RegistryEntryType {
  Standard
  OpenApi
  X402
  A2A
}

enum Status {
  Online
  Offline
  Deregistered
  Invalid
}

enum InboxAgentRegistrationStatus {
  Pending
  Verified
  Invalid
  Deregistered
}

model Capability {
  id            String          @id @default(cuid())
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  name          String
  version       String
  description   String?
  RegistryEntry RegistryEntry[]

  @@unique([name, version])
}

model RegistrySource {
  id                     String               @id @default(cuid())
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  network                Network
  url                    String?
  policyId               String
  RegistrySourceConfig   RegistrySourceConfig @relation(fields: [registrySourceConfigId], references: [id])
  registrySourceConfigId String

  note                   String?
  lastTxId               String?
  lastCheckedPage        Int                      @default(1) //blockfrost starts at page 1
  RegistryEntry          RegistryEntry[]
  InboxAgentRegistration InboxAgentRegistration[]

  @@unique([network, policyId])
}

enum RPCProvider {
  Blockfrost
}

model RegistrySourceConfig {
  id                String           @id @default(cuid())
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  rpcProvider       RPCProvider
  rpcProviderApiKey String
  RegistrySource    RegistrySource[]
}

enum Network {
  Preprod
  Mainnet
}

model UpdatedRegistryEntriesLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One row per seller withdrawal (successful purchase) indexed from the payment
// smart contracts on chain; the time series behind purchase-based ranking. The
// unique key makes re-indexing a page idempotent.
model AgentSuccessfulPurchase {
  id              String                @id @default(cuid())
  createdAt       DateTime              @default(now())
  network         Network
  txHash          String
  redeemerIndex   Int
  // Null when the withdrawal is not attributable to a registered agent (no
  // agent identifier, or the seller did not mint the agent). Kept so later
  // runs skip it.
  agentIdentifier String?
  // Payment key hash of the buyer, set only when the buyer funded the escrow
  // and is not the seller. Ranking counts distinct buyers.
  buyerKeyHash    String?
  blockTime       DateTime?
  Amounts         AgentPurchaseAmount[]

  @@unique([network, txHash, redeemerIndex])
  @@index([network, agentIdentifier, blockTime])
}

// Value paid for one purchase per asset (escrow value minus the buyer's
// collateral return): lovelace or a token unit (policy id + asset name hex).
model AgentPurchaseAmount {
  id         String                  @id @default(cuid())
  unit       String
  quantity   BigInt
  Purchase   AgentSuccessfulPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  purchaseId String

  @@index([purchaseId])
}

// Resume cursor for the purchase indexer, one row per payment contract script.
model PaymentContractSyncState {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  network         Network
  scriptHash      String
  lastCheckedPage Int      @default(1)

  @@unique([network, scriptHash])
}

enum HealthCheckTrigger {
  Job
  Request
  Sync
}

// One row per health check outcome, the time series behind uptimeEwma.
// Pruned after 90 days.
model HealthCheckEvent {
  id              String             @id @default(cuid())
  checkedAt       DateTime
  status          Status
  trigger         HealthCheckTrigger
  RegistryEntry   RegistryEntry      @relation(fields: [registryEntryId], references: [id], onDelete: Cascade)
  registryEntryId String

  @@index([registryEntryId, checkedAt])
  @@index([checkedAt])
}

// What an X402 agent's own resource endpoints answer to an unpaid request
// (MAS-455). One row per manifest resource, refreshed by a slow background job
// and re-created from the live endpoints, so it is derived data: never part of
// a snapshot. Purely informational — it never changes RegistryEntry.status.
enum X402ProbeOutcome {
  // 402 with a usable x402 challenge.
  Payable
  // 2xx: answered without asking for payment.
  Free
  // 402 without a usable challenge, or a resource URL the probe refuses.
  Invalid
  // The probe only sends GET and the resource does not serve it (405, or 404 on
  // a POST-only route).
  Unsupported
  // No answer, or any other status (5xx, redirect, other 4xx).
  Unreachable
}

model X402ResourceProbe {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The manifest resource URL that was probed.
  resource    String
  outcome     X402ProbeOutcome
  httpStatus  Int?
  x402Version Int?
  // Normalized payment requirements the resource asked for (ProbeAccept[]).
  accepts     Json?
  // Does the challenge agree with the entry's registered EVM payment sources?
  // Null when there was nothing to compare (e.g. Cardano-only entries).
  matchesRegisteredSources Boolean?
  mismatches               String[]
  // Why the probe was Invalid or Unreachable.
  reason    String?
  checkedAt DateTime

  RegistryEntry   RegistryEntry @relation(fields: [registryEntryId], references: [id], onDelete: Cascade)
  registryEntryId String

  @@unique([registryEntryId, resource])
  @@index([registryEntryId, checkedAt])
}

// What the registry's OpenAPI discovery last found at an origin an X402 entry's
// manifest resources live on (MAS-453). Rows are written by a background job,
// one per (entry, origin), so it is derived data: never part of a snapshot.
// Purely informational: it never changes RegistryEntry.status.
enum X402OpenApiDiscoveryOutcome {
  // A document was served and passed OpenAPI validation.
  Found
  // The origin answered, but none of the candidate locations served a document.
  NotFound
  // A candidate served something that is not a valid OpenAPI document (or one
  // too large to read), or the origin is a URL the fetcher refuses to contact.
  Invalid
  // The origin did not answer.
  Unreachable
}

model X402OpenApiDiscovery {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // https origin of one or more of the manifest's resources.
  origin         String
  outcome        X402OpenApiDiscoveryOutcome
  // Where the document was found (Found only).
  specUrl        String?
  // OpenAPI version the document declares, e.g. "3.1.0" (Found only).
  openApiVersion String?
  title          String?
  // The document itself, when small enough to sit inline in the row. Null for a
  // larger Found document: specUrl still points at it.
  spec           Json?
  // Why the outcome was Invalid or Unreachable.
  reason         String?
  checkedAt      DateTime

  RegistryEntry   RegistryEntry @relation(fields: [registryEntryId], references: [id], onDelete: Cascade)
  registryEntryId String

  @@unique([registryEntryId, origin])
  @@index([registryEntryId, checkedAt])
}
